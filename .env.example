# =============================================================================
# AgroPet Pr1me - Exemplo de Configuração de Ambiente
# NUNCA insira tokens reais ou credenciais de produção neste arquivo.
# Copie este arquivo para `.env.local` e preencha com seus dados locais.
# =============================================================================

# Supabase (Chave pública para operações no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anonima_publica_aqui

# Contato Comercial Oficial (Apenas números com DDD, ex: 5515999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=5515996580804
NEXT_PUBLIC_SITE_URL=https://agropetpr1me.com.br